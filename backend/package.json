{
  "name": "its-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ITS – API (NestJS) e worker de jobs. Pasta backend do repositório its.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:spikes": "vitest run test/spikes",
    "build": "tsc -p tsconfig.build.json",
    "openapi:export": "tsc -p tsconfig.build.json && node dist/export-openapi.js",
    "migration:generate": "tsc -p tsconfig.build.json && node dist/database/generate-migration.js"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "date-fns": "4.4.0",
    "nodemailer": "10.3.1",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@nestjs/testing": "^12.3.3",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.34.9"
}
