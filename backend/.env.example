# Copie para .env e ajuste. NUNCA versione o .env.
# Em produção (Docker) estas variáveis vêm do .env do repositório "its" (orquestração).

DATABASE_URL=postgresql://its:troque-esta-senha@127.0.0.1:5433/postgres

# Chave para cifrar segredos guardados no banco (RN-90). Gere uma chave aleatória longa:
#   openssl rand -base64 32
APP_SECRET_KEY=

# Observabilidade (RN-92): false desliga a contagem de tráfego e o histórico por hora (a saúde continua).
METRICS_ENABLED=true

# Testes: o banco de testes é criado e descartado a cada execução.
# A suíte recusa rodar se o nome do banco não começar com este prefixo.
TEST_DATABASE_PREFIX=its_test_
