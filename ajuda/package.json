{
  "name": "its-ajuda",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Ajuda do ITS: documentação interativa (Next.js, exportação estática servida em /ajuda/).",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node scripts/publica.mjs && pagefind --site out --output-subdir _pagefind",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:content": "node scripts/check-content.mjs",
    "a11y": "node scripts/a11y.mjs",
    "capturas": "node scripts/capturas.mjs",
    "video": "node scripts/video.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "3.33.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "pagefind": "1.5.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "@ts-morph/common>minimatch": "^11.0.1"
    }
  }
}
