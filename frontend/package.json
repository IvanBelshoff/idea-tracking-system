{
  "name": "its-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ITS – SPA React (Vite + shadcn/ui + Tailwind). Pasta frontend do repositório its.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "api:generate": "node tools/openapi/node_modules/openapi-typescript/bin/cli.js ../backend/openapi.json -o src/api/schema.d.ts",
    "design:contrast": "node scripts/check-contrast.mjs",
    "design:symbol": "node scripts/gen-symbol.mjs",
    "design:icons": "node scripts/gen-icons.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/extension-list": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "4.4.0",
    "i18next": "^26.7.1",
    "lucide-react": "^1.68.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "6.2.5",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "tw-animate-css": "^1.4.0",
    "workbox-window": "^7.4.1",
    "yet-another-react-lightbox": "3.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "2.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "workbox-build>glob": "^14.0.2",
      "@ts-morph/common>minimatch": "^11.0.1"
    }
  }
}
