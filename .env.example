# Copie para .env e preencha. NUNCA versione o .env.
# Os dois valores obrigatórios vêm vazios de propósito: sem eles, o Compose não sobe. Não existe senha
# padrão para trocar depois.

# OBRIGATÓRIO. Senha do banco: só o sistema usa. Gere uma longa, por exemplo: openssl rand -base64 24
# Guarde junto com o backup: o banco criado com ela só abre com ela.
POSTGRES_PASSWORD=

# OBRIGATÓRIO. Chave que cifra os segredos guardados no banco (senha do e-mail, segredos do login
# corporativo, RN-90). Gere com: openssl rand -base64 32
# Guarde junto com o backup: sem ela, esses segredos precisam ser cadastrados de novo.
APP_SECRET_KEY=

# Nome do banco e do usuário (padrão: its). Só mude numa instalação nova.
# POSTGRES_DB=its
# POSTGRES_USER=its

# Versão das imagens: 1 recebe as correções e melhorias da versão 1 sem mudanças que quebram.
# Para fixar uma versão exata, use por exemplo ITS_VERSION=1.0.0.
ITS_VERSION=1

# De onde vêm as imagens: GitHub (padrão) ou Docker Hub (docker.io/ivanbelshoff). As duas são iguais.
# ITS_REGISTRY=ghcr.io/ivanbelshoff

# Onde o sistema fica acessível. Padrão seguro: só nesta máquina.
# Para expor na rede use WEB_BIND=0.0.0.0, de preferência atrás de um proxy com HTTPS.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Fuso horário dos logs da API e do worker (padrão UTC).
TZ=America/Sao_Paulo

# Observabilidade (RN-92): false desliga a contagem de tráfego e o histórico por hora.
# A saúde e os alertas continuam. Quantos dias de histórico ficam guardados: tela Configurações.
METRICS_ENABLED=true

# Login corporativo (RN-96, opcional): só se o servidor sai para a internet por um proxy.
# O ITS fala com a Microsoft/Google apenas se o administrador ligar o login corporativo.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.suaempresa.local:3128
# NO_PROXY=localhost,127.0.0.1,db,api
